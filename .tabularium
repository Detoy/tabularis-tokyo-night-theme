{
  "$schema": "https://registry.tabularis.dev/manifest.schema.json?kind=theme",
  "name": "Tokyo Night",
  "version": "1.0.0",
  "kind": "theme",
  "min_runtime_version": "0.26.0",
  "theme_schema_version": 1,
  "theme_variants": [
    {
      "id": "day",
      "name": "Tokyo Night Day",
      "file": "themes/light.json"
    },
    {
      "id": "night",
      "name": "Tokyo Night Night",
      "file": "themes/dark.json"
    }
  ],
  "id": "tokyo-night-theme",
  "description": "Tokyo Night Day and Night for Tabularis, including SQL editor colors.",
  "license": "MIT AND Apache-2.0",
  "category": "theme",
  "tags": [
    "tokyo-night",
    "light",
    "dark"
  ],
  "homepage": "https://github.com/Detoy/tabularis-tokyo-night-theme",
  "documentation_url": "https://github.com/Detoy/tabularis-tokyo-night-theme#readme",
  "support": {
    "issues_url": "https://github.com/Detoy/tabularis-tokyo-night-theme/issues"
  },
  "screenshots": [
    {
      "url": "https://raw.githubusercontent.com/Detoy/tabularis-tokyo-night-theme/main/docs/screenshots/day-editor.png",
      "caption": "Tokyo Night Day: SQL editor, sidebar and query results",
      "alt": "Tabularis in Tokyo Night Day showing SQL syntax colors and typed query results."
    },
    {
      "url": "https://raw.githubusercontent.com/Detoy/tabularis-tokyo-night-theme/main/docs/screenshots/day-modal.png",
      "caption": "Tokyo Night Day: query parameters dialog",
      "alt": "Tabularis in Tokyo Night Day showing a parameter input and visible keyboard focus."
    },
    {
      "url": "https://raw.githubusercontent.com/Detoy/tabularis-tokyo-night-theme/main/docs/screenshots/night-editor.png",
      "caption": "Tokyo Night Night: SQL editor, sidebar and query results",
      "alt": "Tabularis in Tokyo Night Night showing SQL syntax colors and typed query results."
    },
    {
      "url": "https://raw.githubusercontent.com/Detoy/tabularis-tokyo-night-theme/main/docs/screenshots/night-modal.png",
      "caption": "Tokyo Night Night: query parameters dialog",
      "alt": "Tabularis in Tokyo Night Night showing a parameter input and visible keyboard focus."
    }
  ]
}
