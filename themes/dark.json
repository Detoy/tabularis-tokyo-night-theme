{
  "$schema": "https://raw.githubusercontent.com/TabularisDB/tabularis/main/src/schemas/theme-definition-v1.json",
  "schemaVersion": 1,
  "mode": "dark",
  "attribution": "Tokyo Night palette by folke/tokyonight.nvim (Apache-2.0), adapted by Yug Patel. Selected foreground lightness adjusted for WCAG AA.",
  "colors": {
    "bg": {
      "base": "#1a1b26",
      "elevated": "#16161e",
      "overlay": "#16161e",
      "input": "#16161e",
      "tooltip": "#16161e"
    },
    "surface": {
      "primary": "#16161e",
      "secondary": "#292e42",
      "tertiary": "#283457",
      "hover": "#292e42",
      "active": "#7aa2f7",
      "disabled": "#16161e"
    },
    "text": {
      "primary": "#c0caf5",
      "secondary": "#a9b1d6",
      "muted": "#8f94b4",
      "disabled": "#565f89",
      "accent": "#7aa2f7",
      "inverse": "#000000"
    },
    "accent": {
      "primary": "#7aa2f7",
      "secondary": "#bb9af7",
      "success": "#9ece6a",
      "warning": "#e0af68",
      "error": "#f7768e",
      "info": "#7dcfff"
    },
    "border": {
      "subtle": "#15161e",
      "default": "#3b4261",
      "strong": "#545c7e",
      "focus": "#7aa2f7"
    },
    "semantic": {
      "string": "#9ece6a",
      "number": "#ff9e64",
      "boolean": "#bb9af7",
      "date": "#7dcfff",
      "null": "#7b81a7",
      "primaryKey": "#e0af68",
      "foreignKey": "#7dcfff",
      "index": "#9d7cd8",
      "modified": "#7aa2f7",
      "deleted": "#f7768e",
      "new": "#9ece6a"
    }
  },
  "editor": {
    "colors": {
      "editor.background": "#1a1b26",
      "editor.foreground": "#c0caf5",
      "editor.selectionBackground": "#283457",
      "editor.lineHighlightBackground": "#292e42",
      "editorLineNumber.foreground": "#7982ab",
      "editorLineNumber.activeForeground": "#c0caf5",
      "editorCursor.foreground": "#7aa2f7",
      "editorWidget.background": "#16161e",
      "editorWidget.border": "#545c7e"
    },
    "rules": [
      {
        "token": "comment",
        "foreground": "#7982ab",
        "fontStyle": "italic"
      },
      {
        "token": "keyword",
        "foreground": "#bb9af7"
      },
      {
        "token": "string",
        "foreground": "#9ece6a"
      },
      {
        "token": "number",
        "foreground": "#ff9e64"
      },
      {
        "token": "operator",
        "foreground": "#7dcfff"
      },
      {
        "token": "identifier",
        "foreground": "#c0caf5"
      },
      {
        "token": "identifier.quote",
        "foreground": "#7dcfff"
      },
      {
        "token": "predefined",
        "foreground": "#7aa2f7"
      },
      {
        "token": "delimiter",
        "foreground": "#a9b1d6"
      },
      {
        "token": "invalid",
        "foreground": "#f7768e"
      }
    ]
  }
}
